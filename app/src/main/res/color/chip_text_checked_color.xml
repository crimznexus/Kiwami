<?xml version="1.0" encoding="utf-8"?>
<!-- Text colour for checkable chips. Keyed on state_checked (what Chip.isChecked sets)
     rather than state_selected, so the label actually flips to dark when the chip's
     background turns light. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorSurface" android:state_checked="true" />
    <item android:color="?attr/colorOnBackground" />
</selector>
