<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark ink, so the crimson seal in ic_launcher_foreground.png carries the icon.
         The adaptive-icon mask crops this, so it intentionally paints the whole
         108x108 canvas rather than a shape. Keep in step with the "bgInk" and
         "bgGlow" gradients used to render the legacy and Play Store icons. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="38"
                android:gradientRadius="82"
                android:tileMode="clamp">
                <item
                    android:offset="0"
                    android:color="#34161F" />
                <item
                    android:offset="0.6"
                    android:color="#170B10" />
                <item
                    android:offset="1"
                    android:color="#0C0608" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Faint crimson glow rising from the bottom edge. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="104"
                android:gradientRadius="60"
                android:tileMode="clamp">
                <item
                    android:offset="0"
                    android:color="#4DFF2D5F" />
                <item
                    android:offset="1"
                    android:color="#00FF2D5F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
