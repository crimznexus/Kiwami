<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Kiwami mark: a rounded "K" paired with a play glyph.
         All geometry sits inside the adaptive-icon safe zone (the centre 66x66
         of the 108x108 canvas, i.e. 21..87 on both axes) so no launcher mask
         can clip it. Arms meet the stem at y=54 and their round caps overlap
         the stem, which is what visually joins the letterform. -->
    <group>
        <!-- stem -->
        <path
            android:pathData="M33,33 V75"
            android:strokeColor="#FFF5F8"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <!-- upper arm -->
        <path
            android:pathData="M38.5,54 L53,35.5"
            android:strokeColor="#FFF5F8"
            android:strokeWidth="8.5"
            android:strokeLineCap="round" />
        <!-- lower arm -->
        <path
            android:pathData="M38.5,54 L53,72.5"
            android:strokeColor="#FFF5F8"
            android:strokeWidth="8.5"
            android:strokeLineCap="round" />
        <!-- play glyph: fill plus a same-colour round-joined stroke, which is
             what rounds the three corners without hand-authoring arcs. -->
        <path
            android:pathData="M64,44.5 L77,54 L64,63.5 Z"
            android:fillColor="#FFB3C6"
            android:strokeColor="#FFB3C6"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
