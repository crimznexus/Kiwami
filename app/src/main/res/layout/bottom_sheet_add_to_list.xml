<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/add_to_list"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/addToListMediaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_family"
            android:maxLines="1"
            android:textColor="?attr/colorOutline"
            android:textSize="14sp"
            tools:text="Berserk" />

        <TextView
            android:id="@+id/addToListPlanningNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_family"
            android:text="@string/will_add_to_planning"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/addToListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/addToListCreateNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="12dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/create_new_list"
            android:textColor="?attr/colorPrimary"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_round_add_circle_24"
            app:drawableTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addToListSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/save"
            android:textAllCaps="false"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
